{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/stfulldev/deadweight.gdt/schema/deadweight.gdt.report-v1.schema.json",
  "title": "deadweight.gdt report schema version 1",
  "type": "object",
  "required": ["schema_version", "kind", "tool"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "enum": ["inspect", "tree", "check", "error"] },
    "tool": { "$ref": "#/$defs/tool" },
    "scene": { "$ref": "#/$defs/scene" },
    "configuration": { "$ref": "#/$defs/configuration" },
    "analysis": { "$ref": "#/$defs/analysis" },
    "policy": { "$ref": "#/$defs/policy" },
    "evaluation": { "$ref": "#/$defs/evaluation" },
    "dependency_tree": { "$ref": "#/$defs/dependencyTree" },
    "error": { "$ref": "#/$defs/error" }
  },
  "oneOf": [
    {
      "properties": { "kind": { "const": "inspect" } },
      "required": ["scene", "configuration", "analysis"],
      "not": {
        "anyOf": [
          { "required": ["policy"] },
          { "required": ["evaluation"] },
          { "required": ["dependency_tree"] },
          { "required": ["error"] }
        ]
      }
    },
    {
      "properties": { "kind": { "const": "tree" } },
      "required": ["scene", "configuration", "analysis", "dependency_tree"],
      "not": {
        "anyOf": [
          { "required": ["policy"] },
          { "required": ["evaluation"] },
          { "required": ["error"] }
        ]
      }
    },
    {
      "properties": { "kind": { "const": "check" } },
      "required": ["scene", "configuration", "analysis", "policy", "evaluation"],
      "not": {
        "anyOf": [
          { "required": ["dependency_tree"] },
          { "required": ["error"] }
        ]
      }
    },
    {
      "properties": { "kind": { "const": "error" } },
      "required": ["error"],
      "not": {
        "anyOf": [
          { "required": ["scene"] },
          { "required": ["configuration"] },
          { "required": ["analysis"] },
          { "required": ["policy"] },
          { "required": ["evaluation"] },
          { "required": ["dependency_tree"] }
        ]
      }
    }
  ],
  "$defs": {
    "int64": {
      "type": "integer",
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807
    },
    "nonNegativeInt64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "deadweight.gdt" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "portablePath": {
      "type": "string",
      "pattern": "^res://[^\\\\]*$"
    },
    "scene": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "$ref": "#/$defs/portablePath" }
      }
    },
    "dependencyTreeEntry": {
      "type": "object",
      "required": [
        "depth", "source", "target", "kind", "resolved", "occurrences",
        "reliability", "back_reference"
      ],
      "properties": {
        "depth": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "source": { "$ref": "#/$defs/portablePath" },
        "target": { "type": "string", "minLength": 1, "pattern": "^[^\\\\]*$" },
        "kind": { "enum": ["instance", "inheritance"] },
        "resolved": { "type": "boolean" },
        "occurrences": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "reliability": { "enum": ["exact", "lower_bound", "approximate"] },
        "back_reference": { "type": "boolean" },
        "classification": {
          "enum": [
            "missing_external_resource", "unresolved_path", "imported_scene",
            "unsupported_scene", "sub_resource", "placeholder", "unavailable_scene",
            "inherited_scene"
          ]
        },
        "resource_id": { "type": "string", "minLength": 1, "pattern": "^[^\\\\]*$" },
        "raw_target": { "type": "string", "minLength": 1, "pattern": "^[^\\\\]*$" },
        "resolution_reason": {
          "enum": [
            "resolved", "invalid_project_root", "invalid_working_directory", "invalid_scene_input",
            "empty", "uid_only", "user_data", "unsupported_target", "missing",
            "outside_project", "filesystem", "invalid_declaring_scene"
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "resolved": { "const": true } }, "required": ["resolved"] },
          "then": {
            "properties": {
              "target": { "$ref": "#/$defs/portablePath" }
            },
            "not": {
              "anyOf": [
                { "required": ["classification"] },
                { "required": ["resolution_reason"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "resolved": { "const": false } }, "required": ["resolved"] },
          "then": {
            "required": ["classification", "resolution_reason"],
            "properties": { "back_reference": { "const": false } }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "inheritance" } }, "required": ["kind"] },
          "then": { "properties": { "reliability": { "const": "approximate" } } }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "instance" },
              "resolved": { "const": true }
            },
            "required": ["kind", "resolved"]
          },
          "then": { "properties": { "reliability": { "const": "exact" } } }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "instance" },
              "resolved": { "const": false }
            },
            "required": ["kind", "resolved"]
          },
          "then": { "properties": { "reliability": { "const": "lower_bound" } } }
        }
      ]
    },
    "dependencyTree": {
      "type": "object",
      "required": ["root", "entries"],
      "properties": {
        "root": { "$ref": "#/$defs/portablePath" },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/dependencyTreeEntry" } }
      }
    },
    "configuration": {
      "type": "object",
      "required": ["present", "selection"],
      "properties": {
        "present": { "type": "boolean" },
        "selection": { "enum": ["absent", "implicit", "explicit"] },
        "path": { "$ref": "#/$defs/portablePath" }
      },
      "allOf": [
        {
          "if": { "properties": { "present": { "const": false } }, "required": ["present"] },
          "then": {
            "properties": { "selection": { "const": "absent" } },
            "not": { "required": ["path"] }
          }
        },
        {
          "if": { "properties": { "present": { "const": true } }, "required": ["present"] },
          "then": { "properties": { "selection": { "enum": ["implicit", "explicit"] } } }
        }
      ]
    },
    "metricName": {
      "enum": [
        "nodes",
        "tree_depth",
        "scene_instances",
        "mesh_instances",
        "lights",
        "shadow_lights",
        "external_resources",
        "scene_dependencies"
      ]
    },
    "confidenceReason": {
      "enum": [
        "unresolved_scene_instance",
        "imported_scene",
        "unsupported_scene",
        "subresource_scene",
        "placeholder_instance",
        "unavailable_scene",
        "unavailable_resource",
        "unsupported_resource_path",
        "inherited_scene",
        "unsupported_parent"
      ]
    },
    "confidence": {
      "type": "object",
      "required": ["reliability", "reasons"],
      "properties": {
        "reliability": { "enum": ["exact", "lower_bound", "approximate"] },
        "reasons": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/confidenceReason" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "reliability": { "const": "exact" } },
            "required": ["reliability"]
          },
          "then": { "properties": { "reasons": { "maxItems": 0 } } },
          "else": { "properties": { "reasons": { "minItems": 1 } } }
        }
      ]
    },
    "metric": {
      "type": "object",
      "required": ["id", "value"],
      "properties": {
        "id": { "$ref": "#/$defs/metricName" },
        "value": { "$ref": "#/$defs/nonNegativeInt64" },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "prefixItems": [
        { "allOf": [{ "$ref": "#/$defs/metric" }, { "properties": { "id": { "const": "nodes" } } }] },
        { "allOf": [{ "$ref": "#/$defs/metric" }, { "properties": { "id": { "const": "tree_depth" } } }] },
        { "allOf": [{ "$ref": "#/$defs/metric" }, { "properties": { "id": { "const": "scene_instances" } } }] },
        { "allOf": [{ "$ref": "#/$defs/metric" }, { "properties": { "id": { "const": "mesh_instances" } } }] },
        { "allOf": [{ "$ref": "#/$defs/metric" }, { "properties": { "id": { "const": "lights" } } }] },
        { "allOf": [{ "$ref": "#/$defs/metric" }, { "properties": { "id": { "const": "shadow_lights" } } }] },
        { "allOf": [{ "$ref": "#/$defs/metric" }, { "properties": { "id": { "const": "external_resources" } } }] },
        { "allOf": [{ "$ref": "#/$defs/metric" }, { "properties": { "id": { "const": "scene_dependencies" } } }] }
      ],
      "items": false
    },
    "contributionMetric": {
      "type": "object",
      "required": ["id", "aggregation"],
      "properties": {
        "id": { "$ref": "#/$defs/metricName" },
        "aggregation": { "enum": ["additive", "maximum", "unique_union"] },
        "value": { "$ref": "#/$defs/nonNegativeInt64" },
        "available": { "type": "boolean" },
        "confidence": { "$ref": "#/$defs/confidence" }
      },
      "allOf": [
        {
          "if": { "properties": { "aggregation": { "const": "additive" } }, "required": ["aggregation"] },
          "then": { "required": ["value"], "not": { "required": ["available"] } }
        },
        {
          "if": { "properties": { "aggregation": { "const": "maximum" } }, "required": ["aggregation"] },
          "then": {
            "required": ["available"],
            "allOf": [
              {
                "if": { "properties": { "available": { "const": true } }, "required": ["available"] },
                "then": { "required": ["value"] },
                "else": { "not": { "required": ["value"] } }
              }
            ]
          }
        },
        {
          "if": { "properties": { "aggregation": { "const": "unique_union" } }, "required": ["aggregation"] },
          "then": { "not": { "anyOf": [{ "required": ["value"] }, { "required": ["available"] }] } }
        }
      ]
    },
    "contributionMetrics": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        { "allOf": [{ "$ref": "#/$defs/contributionMetric" }, { "properties": { "id": { "const": "nodes" }, "aggregation": { "const": "additive" } } }] },
        { "allOf": [{ "$ref": "#/$defs/contributionMetric" }, { "properties": { "id": { "const": "tree_depth" }, "aggregation": { "const": "maximum" } } }] },
        { "allOf": [{ "$ref": "#/$defs/contributionMetric" }, { "properties": { "id": { "const": "scene_instances" }, "aggregation": { "const": "additive" } } }] },
        { "allOf": [{ "$ref": "#/$defs/contributionMetric" }, { "properties": { "id": { "const": "mesh_instances" }, "aggregation": { "const": "additive" } } }] },
        { "allOf": [{ "$ref": "#/$defs/contributionMetric" }, { "properties": { "id": { "const": "lights" }, "aggregation": { "const": "additive" } } }] },
        { "allOf": [{ "$ref": "#/$defs/contributionMetric" }, { "properties": { "id": { "const": "shadow_lights" }, "aggregation": { "const": "additive" } } }] },
        { "allOf": [{ "$ref": "#/$defs/contributionMetric" }, { "properties": { "id": { "const": "external_resources" }, "aggregation": { "const": "unique_union" } } }] },
        { "allOf": [{ "$ref": "#/$defs/contributionMetric" }, { "properties": { "id": { "const": "scene_dependencies" }, "aggregation": { "const": "unique_union" } } }] }
      ],
      "items": false
    },
    "contribution": {
      "type": "object",
      "required": ["kind", "scene", "occurrences", "reliability", "metrics"],
      "properties": {
        "kind": { "enum": ["root", "scene", "inherited", "unresolved"] },
        "scene": { "type": "string", "minLength": 1, "pattern": "^[^\\\\]*$" },
        "declaring_scene": { "$ref": "#/$defs/portablePath" },
        "mount_path": { "type": "string", "minLength": 1, "pattern": "^[^\\\\]*$" },
        "mount_depth": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "resource_id": { "type": "string", "minLength": 1 },
        "raw_target": { "type": "string", "minLength": 1, "pattern": "^[^\\\\]*$" },
        "classification": {
          "enum": [
            "missing_external_resource", "unresolved_path", "imported_scene",
            "unsupported_scene", "sub_resource", "placeholder", "unavailable_scene",
            "inherited_scene"
          ]
        },
        "occurrences": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "reliability": { "enum": ["exact", "lower_bound", "approximate"] },
        "metrics": { "$ref": "#/$defs/contributionMetrics" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "root" } }, "required": ["kind"] },
          "then": { "not": { "required": ["declaring_scene"] } }
        },
        {
          "if": { "properties": { "kind": { "enum": ["scene", "inherited", "unresolved"] } }, "required": ["kind"] },
          "then": { "required": ["declaring_scene"] }
        },
        {
          "if": { "properties": { "kind": { "const": "unresolved" } }, "required": ["kind"] },
          "then": { "required": ["classification"] }
        }
      ]
    },
    "uniqueReferrer": {
      "type": "object",
      "required": ["scene", "occurrences"],
      "properties": {
        "scene": { "$ref": "#/$defs/portablePath" },
        "resource_id": { "type": "string", "minLength": 1 },
        "raw_target": { "type": "string", "minLength": 1, "pattern": "^[^\\\\]*$" },
        "edge_kind": { "enum": ["instance", "inheritance"] },
        "occurrences": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 }
      }
    },
    "uniqueEvidence": {
      "type": "object",
      "required": ["metric", "identity", "referrers"],
      "properties": {
        "metric": { "enum": ["external_resources", "scene_dependencies"] },
        "identity": { "type": "string", "minLength": 1, "pattern": "^[^\\\\]*$" },
        "referrers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/uniqueReferrer" }
        }
      }
    },
    "topContributors": {
      "type": "object",
      "required": ["metric", "limit", "rows"],
      "properties": {
        "metric": {
          "enum": ["nodes", "tree_depth", "scene_instances", "mesh_instances", "lights", "shadow_lights"]
        },
        "limit": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "rows": { "type": "array", "items": { "$ref": "#/$defs/contribution" } }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "parsed_scene_files",
        "resolved_scene_instances",
        "unresolved_scene_instances",
        "inherited_scenes"
      ],
      "properties": {
        "parsed_scene_files": { "$ref": "#/$defs/nonNegativeInt64" },
        "resolved_scene_instances": { "$ref": "#/$defs/nonNegativeInt64" },
        "unresolved_scene_instances": { "$ref": "#/$defs/nonNegativeInt64" },
        "inherited_scenes": { "$ref": "#/$defs/nonNegativeInt64" }
      }
    },
    "source": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "$ref": "#/$defs/portablePath" },
        "line": { "$ref": "#/$defs/nonNegativeInt64" },
        "column": { "$ref": "#/$defs/nonNegativeInt64" }
      }
    },
    "diagnosticCode": {
      "enum": [
        "SB1001", "SB1002", "SB1003", "SB1004", "SB1005", "SB1006",
        "SB1007", "SB1008", "SB2001", "SB2002", "SB2003", "SB2004"
      ]
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "severity", "message", "occurrences"],
      "properties": {
        "code": { "$ref": "#/$defs/diagnosticCode" },
        "severity": { "enum": ["warning", "error"] },
        "message": { "type": "string", "minLength": 1 },
        "occurrences": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "source": { "$ref": "#/$defs/source" },
        "resource": { "type": "string", "minLength": 1, "pattern": "^[^\\\\]*$" }
      }
    },
    "analysis": {
      "type": "object",
      "required": [
        "status", "reliability", "metrics", "coverage", "diagnostics",
        "contributions", "unique_evidence"
      ],
      "properties": {
        "status": { "enum": ["complete", "partial"] },
        "reliability": { "enum": ["exact", "lower_bound", "approximate"] },
        "metrics": { "$ref": "#/$defs/metrics" },
        "coverage": { "$ref": "#/$defs/coverage" },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
        "contributions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/contribution" } },
        "unique_evidence": { "type": "array", "items": { "$ref": "#/$defs/uniqueEvidence" } },
        "top_contributors": { "$ref": "#/$defs/topContributors" }
      }
    },
    "policyMetadata": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "platform": { "type": "string" },
        "renderer": { "type": "string" },
        "target_fps": { "$ref": "#/$defs/nonNegativeInt64" },
        "quality": { "type": "string" },
        "status": { "type": "string" },
        "stability": { "type": "string" }
      }
    },
    "policy": {
      "type": "object",
      "required": ["kind", "metadata", "fail_on_partial"],
      "properties": {
        "kind": { "enum": ["preset", "profile", "overrides"] },
        "id": { "type": "string", "minLength": 1 },
        "metadata": { "$ref": "#/$defs/policyMetadata" },
        "fail_on_partial": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "enum": ["preset", "profile"] } }, "required": ["kind"] },
          "then": { "required": ["id"] }
        },
        {
          "if": { "properties": { "kind": { "const": "overrides" } }, "required": ["kind"] },
          "then": { "not": { "required": ["id"] } }
        }
      ]
    },
    "comparison": {
      "type": "object",
      "required": ["metric", "observed", "limit", "delta", "passed"],
      "properties": {
        "metric": { "$ref": "#/$defs/metricName" },
        "observed": { "$ref": "#/$defs/nonNegativeInt64" },
        "limit": { "$ref": "#/$defs/nonNegativeInt64" },
        "delta": { "$ref": "#/$defs/int64" },
        "passed": { "type": "boolean" }
      }
    },
    "evaluation": {
      "type": "object",
      "required": ["comparisons", "exceeded", "verdict"],
      "properties": {
        "comparisons": { "type": "array", "items": { "$ref": "#/$defs/comparison" } },
        "exceeded": { "$ref": "#/$defs/nonNegativeInt64" },
        "verdict": { "enum": ["PASSED", "FAILED", "INCOMPLETE"] }
      }
    },
    "error": {
      "type": "object",
      "required": ["severity", "message"],
      "properties": {
        "code": { "$ref": "#/$defs/diagnosticCode" },
        "severity": { "const": "error" },
        "message": { "type": "string", "minLength": 1 },
        "details": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
